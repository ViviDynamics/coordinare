# Runtime secrets and environment-specific settings
COORDINARE_GITHUB_TOKEN=
COORDINARE_SLACK_WEBHOOK_URL=
COORDINARE_SMTP_PASSWORD=

# Runtime controls
COORDINARE_LOG_LEVEL=info
COORDINARE_OUTPUT_MODE=human

# --- LLM provider routing (065) --------------------------------------------
# Coordinare and its performers honor any OpenAI-compatible endpoint without
# hard-coding LiteLLM.  Pick whichever block matches your routing.
#
# OpenAI direct (default):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
#
# LiteLLM (or any OpenAI-compatible proxy):
# LITELLM_MASTER_KEY=...
#   Conducting `openai_api`   → config.yaml: api_key_env: LITELLM_MASTER_KEY,
#                                              base_url: https://litellm.example/v1
#   Conducting `anthropic_api`→ config.yaml: api_key_env: LITELLM_MASTER_KEY,
#                                              base_url: https://litellm.example/anthropic
#   Conducting `claude_cli`   → also exports ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN
# ANTHROPIC_BASE_URL=https://litellm.example/anthropic
# ANTHROPIC_AUTH_TOKEN=${LITELLM_MASTER_KEY}
#
# Performer `codex`        → set CODEX_PROVIDER_BASE_URL (+ optional NAME/ENV_KEY/
#                            WIRE_API) in the matching performer_endpoints[].env
# Performer `claude_code`  → declare ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN in
#                            the matching performer_endpoints[].env so the
#                            container's `claude` CLI picks them up.
#
# Performer `junie`        → set JUNIE_PROVIDER_BASE_URL (+ optional MODEL_ID/
#                            API_TYPE/MODEL/API_KEY_ENV) in the matching
#                            performer_endpoints[].env. The backend writes a
#                            profile to $JUNIE_HOME/models/<id>.json on start
#                            and selects it via `--model custom:<id>`. See
#                            https://junie.jetbrains.com/docs/custom-llm-models.html
# JUNIE_PROVIDER_BASE_URL=https://litellm.example/v1
# JUNIE_PROVIDER_MODEL_ID=vivi
# JUNIE_PROVIDER_API_TYPE=OpenAICompletion   # or OpenAIResponses / Anthropic / Google
# JUNIE_PROVIDER_MODEL=gpt-4o-mini
# JUNIE_PROVIDER_API_KEY_ENV=LITELLM_MASTER_KEY
