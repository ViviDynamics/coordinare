#!/usr/bin/env bash
# Rerun a run's failed jobs and prove it happened (run_attempt increments).
# usage: verified-rerun <run_id> (--pr <pr> | --branch <branch>) [--wait-sec N]
# exit: 0 verified, 1 rerun did not happen, 4 precondition failed
set -euo pipefail
source "$(dirname "$0")/_lib.sh"
coordinare_load_env; coordinare_require COORDINARE_REPO
run_id=${1:-}; [ -n "$run_id" ] || coordinare_die 2 "usage: verified-rerun <run_id> (--pr <pr> | --branch <branch>) [--wait-sec N]"
shift; pr=""; branch=""; wait_sec=120
while [ $# -gt 0 ]; do
  case "$1" in --pr) pr=$2; shift 2;; --branch) branch=$2; shift 2;; --wait-sec) wait_sec=$2; shift 2;; *) coordinare_die 2 "unknown option $1";; esac
done
if [ -n "$pr" ]; then
  head=$(coordinare_gh pr view "$pr" --repo "$COORDINARE_REPO" --json headRefOid --jq .headRefOid) || exit $?
elif [ -n "$branch" ]; then
  head=$(coordinare_gh api "repos/$COORDINARE_REPO/branches/$branch" --jq .commit.sha) || exit $?
else
  coordinare_die 2 "--pr or --branch is required (head SHA check)"
fi
info=$(coordinare_gh api "repos/$COORDINARE_REPO/actions/runs/$run_id") || exit $?
status=$(printf '%s' "$info" | jq -r .status)
run_head=$(printf '%s' "$info" | jq -r .head_sha)
before=$(printf '%s' "$info" | jq -r .run_attempt)
if [ "$status" != "completed" ]; then
  printf '{"run_id":%s,"verified":false,"reason":"run is %s, rerun would silently no-op"}\n' "$run_id" "$status"; exit 4
fi
if [ "$run_head" != "$head" ]; then
  printf '{"run_id":%s,"verified":false,"reason":"run head %s is not the current head %s; rerunning a stale run cancels live CI"}\n' "$run_id" "$run_head" "$head"; exit 4
fi
coordinare_gh run rerun "$run_id" --failed --repo "$COORDINARE_REPO" >/dev/null || exit $?
start=$(date +%s); after=$before
while :; do
  after=$(coordinare_gh api "repos/$COORDINARE_REPO/actions/runs/$run_id" | jq -r .run_attempt) || after=$before
  if [ "$after" -gt "$before" ]; then break; fi
  if [ $(( $(date +%s) - start )) -ge "$wait_sec" ]; then break; fi
  coordinare_sleep 10
done
if [ "$after" -gt "$before" ]; then
  printf '{"run_id":%s,"attempt_before":%s,"attempt_after":%s,"verified":true}\n' "$run_id" "$before" "$after"; exit 0
fi
printf '{"run_id":%s,"attempt_before":%s,"attempt_after":%s,"verified":false,"reason":"run_attempt did not increment within %ss"}\n' "$run_id" "$before" "$after" "$wait_sec"; exit 1
