        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "plan_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Path"
    },
    "comments": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Comments",
      "type": "array"
    },
    "suggestions": {
      "items": {
        "type": "string"
      },
      "title": "Suggestions",
      "type": "array"
    },
    "findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Findings",
      "type": "array"
    },
    "failures": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Failures",
      "type": "array"
    },
    "report": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report"
    },
    "files_modified": {
      "items": {
        "type": "string"
      },
      "title": "Files Modified",
      "type": "array"
    },
    "events": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Events",
      "type": "array"
    },
