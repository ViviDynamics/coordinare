COORDINARE_REPO=ViviDynamics/coordinare
COORDINARE_DEFAULT_BRANCH=main
COORDINARE_MERGE_FLAGS=--squash --delete-branch
COORDINARE_CI_WORKFLOW=pr-ci.yml
# Workflow FILES that run on pull requests but are advisory here: the gate is pr-ci.yml
# alone, as before 2026.11.0. Path-filtered or event-only workflows listed here never gate.
COORDINARE_CI_IGNORE_WORKFLOWS="docker_setup.yml service.yml windows-git-env.yml external-contributions.yml"
# Per person: set your own GitHub login in your local repo.env, never here.
# Empty: ship-issue claims issues as the token's own login.
COORDINARE_ASSIGNEE=
COORDINARE_REVIEW_TOOL=copilot
COORDINARE_HOUSE_RULES_FILE=AGENTS.md
COORDINARE_BRANCH_PATTERN={issue}-{slug}
COORDINARE_FLAKE_SIGNATURES_FILE=.agents/flake-signatures.txt
COORDINARE_TEST_COMMANDS_FILE=.agents/test-commands.md
# disclosure-guard: this repository is public. The private term list is never committed;
# CI reads it from a secret, agents from ~/.config/vivi/disclosure-terms.
COORDINARE_REPO_VISIBILITY=public
