FROM python:3.12-slim

# Install base utilities and Node.js 22 LTS in a single layer to avoid
# redundant apt-get update calls that waste cache and inflate image size.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates jq ripgrep bash gnupg iptables dnsutils \
    unzip \
    build-essential cmake pkg-config \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# spec-106: snapshot the pristine base installed-set so the env-bootstrap service-deb
# fetch (_render_system_services_install) can resolve "what the base image lacks" (e.g.
# libicu76) via `apt-get install --download-only -o Dir::State::status=<this file>`,
# independent of whatever the bootstrap container later installs. Without this, a runtime
# lib already installed into the container (by the QA browser etc.) is skipped by
# --download-only and never reaches the cache, so the extracted server can't load it.
RUN cp /var/lib/dpkg/status /opt/coordinare-base-dpkg-status

# Install rtk (token-compression CLI proxy). Pinned to v0.39.0; bump
# deliberately, not floated to latest. Build fails loudly if the binary
# can't be installed — we do not want a silently-missing rtk on images
# that downstream operators have flagged RTK_ENABLED=1 for.
ARG RTK_VERSION=0.39.0
RUN set -eu \
    && arch="$(uname -m)" \
    && case "$arch" in \
         x86_64)  asset="rtk-x86_64-unknown-linux-musl.tar.gz"; sha="06e582ba1996ef03e76a441b9896aba79dd1b746ce539d228296c681b1c5401c" ;; \
         aarch64) asset="rtk-aarch64-unknown-linux-gnu.tar.gz";  sha="68fd34cbff46856826a092c261d67b1b80b579ef6c8a0400c0089e14325e709d" ;; \
         *) echo "Unsupported arch for rtk: $arch" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/rtk.tar.gz "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/${asset}" \
    && echo "${sha}  /tmp/rtk.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/rtk.tar.gz -C /tmp \
    && install -m 0755 /tmp/rtk /usr/local/bin/rtk \
    && rm -rf /tmp/rtk /tmp/rtk.tar.gz \
    && rtk --version

# pip and its vendored certifi from verified wheels first: the base image's pip
# still trusts the distrusted emSign CAs (#361).
RUN python -m pip install --no-cache-dir --no-deps \
    "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70" \
    "certifi @ https://files.pythonhosted.org/packages/c4/51/29046e48f693c54e5b7412216d447a1d8362c9653148d98c02cdf65fa733/certifi-2026.10.19-py3-none-any.whl#sha256=42d35340cc5b9ba78e818ddbff0c5b1c2b779de448a340fd1b989f5fa8670e1b"

# Install shared service_inference package first (performer depends on it).
# Build context must be repo root so we can reach ../../packages/.
# Export the reviewed runtime lock before pip installs any project packages.
# Keep the constraints file for later installs in the full image as well.
RUN pip install --no-cache-dir uv==0.13.5
COPY agent/performer/pyproject.toml agent/performer/uv.lock /tmp/performer-lock/
RUN uv export --project /tmp/performer-lock --frozen --no-dev --no-emit-local \
        --no-hashes --output-file /opt/performer-constraints.txt \
    && pip install --no-cache-dir -r /opt/performer-constraints.txt \
    && rm -rf /tmp/performer-lock
# Build-only: project commands inside a running performer must resolve their
# own dependencies without inheriting the performer's package constraints.
ARG PIP_CONSTRAINT=/opt/performer-constraints.txt

WORKDIR /pkgs/service_inference
COPY packages/service_inference/pyproject.toml ./
COPY packages/service_inference/src/ ./src/
RUN pip install --no-cache-dir .

# Issue #228: the spec-078 routing-table models. The performer re-exports them from
# performer.proxy.routing, and the daemon validates against the same package.
WORKDIR /pkgs/routing_models
COPY packages/routing_models/pyproject.toml ./
COPY packages/routing_models/src/ ./src/
RUN pip install --no-cache-dir .

# 339: the performer imports CI/test-command detection. It used to reach for
# coordinare.services.ci_detection, but this image has never shipped coordinare
# (only packages/ and agent/performer are copied), so that import always raised
# ImportError and the implementer hard-blocked cards with "no test runner
# detected". The logic now lives in a shared package both sides install.
WORKDIR /pkgs/ci_detection
COPY packages/ci_detection/pyproject.toml ./
COPY packages/ci_detection/src/ ./src/
RUN pip install --no-cache-dir .

# Install performer package
WORKDIR /app
COPY agent/performer/pyproject.toml agent/performer/README.md ./
COPY agent/performer/src/ ./src/
# Strip the path-source override that points to packages/service_inference —
# inside the image we install the wheel directly above, and the relative path
# `../../packages/service_inference` doesn't exist here.
RUN sed -i '/\[tool\.uv\.sources\]/,/^$/d' pyproject.toml && \
    pip install --no-cache-dir .

# Install the selected backend at startup for both published variants.
COPY agent/performer/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV PATH="/root/.local/bin:${PATH}"
ENTRYPOINT ["/entrypoint.sh"]
