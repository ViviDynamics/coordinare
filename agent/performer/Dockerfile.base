FROM python:3.12-slim

# Install base utilities and Node.js 22 LTS in a single layer to avoid
# redundant apt-get update calls that waste cache and inflate image size.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates jq ripgrep bash gnupg iptables dnsutils \
    unzip \
    build-essential cmake pkg-config \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
       | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
       > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# spec-106: snapshot the pristine base installed-set so the env-bootstrap service-deb
# fetch (_render_system_services_install) can resolve "what the base image lacks" (e.g.
# libicu76) via `apt-get install --download-only -o Dir::State::status=<this file>`,
# independent of whatever the bootstrap container later installs. Without this, a runtime
# lib already installed into the container (by the QA browser etc.) is skipped by
# --download-only and never reaches the cache, so the extracted server can't load it.
RUN cp /var/lib/dpkg/status /opt/coordinare-base-dpkg-status

# Install rtk (token-compression CLI proxy). Pinned to v0.39.0; bump
# deliberately, not floated to latest. Build fails loudly if the binary
# can't be installed — we do not want a silently-missing rtk on images
# that downstream operators have flagged RTK_ENABLED=1 for.
ARG RTK_VERSION=0.39.0
RUN set -eu \
    && arch="$(uname -m)" \
    && case "$arch" in \
         x86_64)  asset="rtk-x86_64-unknown-linux-musl.tar.gz"; sha="06e582ba1996ef03e76a441b9896aba79dd1b746ce539d228296c681b1c5401c" ;; \
         aarch64) asset="rtk-aarch64-unknown-linux-gnu.tar.gz";  sha="68fd34cbff46856826a092c261d67b1b80b579ef6c8a0400c0089e14325e709d" ;; \
         *) echo "Unsupported arch for rtk: $arch" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /tmp/rtk.tar.gz "https://github.com/rtk-ai/rtk/releases/download/v${RTK_VERSION}/${asset}" \
    && echo "${sha}  /tmp/rtk.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/rtk.tar.gz -C /tmp \
    && install -m 0755 /tmp/rtk /usr/local/bin/rtk \
    && rm -rf /tmp/rtk /tmp/rtk.tar.gz \
    && rtk --version

# Install shared service_inference package first (performer depends on it).
# Build context must be repo root so we can reach ../../packages/.
WORKDIR /pkgs/service_inference
COPY packages/service_inference/pyproject.toml ./
COPY packages/service_inference/src/ ./src/
RUN pip install --no-cache-dir .

# Install performer package
WORKDIR /app
COPY agent/performer/pyproject.toml agent/performer/README.md ./
COPY agent/performer/src/ ./src/
# Strip the path-source override that points to packages/service_inference —
# inside the image we install the wheel directly above, and the relative path
# `../../packages/service_inference` doesn't exist here.
RUN sed -i '/\[tool\.uv\.sources\]/,/^$/d' pyproject.toml && \
    pip install --no-cache-dir .

# Entrypoint: serve HTTP API on port 8088
ENTRYPOINT ["python", "-m", "performer", "--serve", "--port", "8088"]
