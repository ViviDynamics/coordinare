# Dockerfile.extra — browser-heavy performer image for browser-driven QA.
#
# Layers real system browsers (chromium + firefox-esr) ON TOP of :full so the
# base/full images stay lean and fast to build; only roles that actually run
# browser-driven tests (e.g. qa) point at coordinare-performer:extra. Capybara /
# selenium-webdriver / webdrivers reliably install as gems but the browser
# binaries themselves are the thing env-bootstrap keeps failing to get going —
# so we bake them into the image instead.
#
# Why not just google-chrome-stable? Google ships Linux Chrome for amd64 ONLY —
# there is no arm64 build. These images build arm64 (Apple Silicon), so on arm64
# we install chromium (Chrome's open-source base; selenium/capybara drive it via
# chromedriver identically) and alias the common binary names. Docker provides
# TARGETARCH automatically under buildx, so the same Dockerfile still installs
# real google-chrome-stable when built for amd64 — future-proof multi-arch.
#
# NOTE: the base is python:3.12-slim (Debian, NOT Ubuntu), so the package is
# `chromium` / `chromium-driver`, not Ubuntu's `chromium-browser` snap stub.
ARG BASE_IMAGE=coordinare-performer:full
FROM $BASE_IMAGE

ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        gnupg \
        firefox-esr \
        fonts-liberation \
    && if [ "$TARGETARCH" = "amd64" ]; then \
         # amd64: real Google Chrome from Google's apt repo, plus chromium for parity.
         wget -q -O /tmp/google-key.pub https://dl.google.com/linux/linux_signing_key.pub && \
         gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg /tmp/google-key.pub && \
         rm -f /tmp/google-key.pub && \
         echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
             > /etc/apt/sources.list.d/google-chrome.list && \
         apt-get update && apt-get install -y --no-install-recommends \
             google-chrome-stable chromium chromium-driver; \
       else \
         # arm64 (and anything non-amd64): chromium is the Chrome stand-in. Alias
         # the google-chrome names so test suites / selenium probing for them resolve.
         apt-get install -y --no-install-recommends chromium chromium-driver && \
         ln -sf /usr/bin/chromium /usr/local/bin/google-chrome && \
         ln -sf /usr/bin/chromium /usr/local/bin/google-chrome-stable; \
       fi \
    # Common alias names regardless of arch: many suites probe `chromium-browser`
    # (Ubuntu name) or `firefox` (the firefox-esr binary is `firefox-esr`).
    && ln -sf /usr/bin/chromium /usr/local/bin/chromium-browser && \
       ln -sf /usr/bin/firefox-esr /usr/local/bin/firefox \
    && rm -rf /var/lib/apt/lists/*

# geckodriver: Debian packages firefox-esr but NOT geckodriver, so a Firefox
# Selenium session has no driver at all. Installed from Mozilla's releases with
# the same retry shape Dockerfile.full uses for playwright, because a transient
# network blip during a build should not silently ship a browser that cannot be
# driven.
ARG GECKODRIVER_VERSION=0.35.0
RUN set -eux; \
    case "${TARGETARCH:-arm64}" in \
      amd64) GD_ARCH=linux64 ;; \
      arm64) GD_ARCH=linux-aarch64 ;; \
      *) GD_ARCH=linux64 ;; \
    esac; \
    n=0; until wget -q -O /tmp/gd.tar.gz \
        "https://github.com/mozilla/geckodriver/releases/download/v${GECKODRIVER_VERSION}/geckodriver-v${GECKODRIVER_VERSION}-${GD_ARCH}.tar.gz"; do \
      n=$((n+1)); [ "$n" -ge 5 ] && exit 1; sleep 5; \
    done; \
    tar -xzf /tmp/gd.tar.gz -C /usr/bin geckodriver; \
    rm -f /tmp/gd.tar.gz; \
    chmod +x /usr/bin/geckodriver; \
    geckodriver --version | head -1

# 385: the `webdrivers` gem does NOT fall back to a driver already on PATH. It
# overrides Selenium's driver path with its own download directory and, when
# that download has not happened, hands Selenium a path to a file that does not
# exist:
#
#     webdrivers resolves driver to: /root/.webdrivers/chromedriver
#     ls: cannot access '/root/.webdrivers/': No such file or directory
#     WebDriverError: unable to connect to /root/.webdrivers/chromedriver
#
# ...while /usr/bin/chromedriver sits next to a matching Chromium, working. That
# is why every Selenium feature spec failed in this image while the same commit
# passed CI, where the gem can reach its download endpoint.
#
# Pointing the gem's install dir at the system one makes it adopt the drivers
# installed above instead of downloading. Verified with --network none, which
# matters: a fix that needs a download reintroduces the failure on a restricted
# network. Harmless for suites that do not use the gem.
#
# The comment this replaces claimed chromedriver "is provided by chromium-driver
# above" — true, and irrelevant while the gem overrode the path.
ENV WD_INSTALL_DIR=/usr/bin

# Headless is the caller's flag, not baked here.
