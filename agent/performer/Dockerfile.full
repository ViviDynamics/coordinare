ARG BASE_IMAGE=coordinare-performer:base
# 423: QAre for the QA stage provider runs in this image (a stage job), never on
# coordinare's host. Its published image is the release, pinned by digest; only its
# /opt/qare tree is copied (the CLI, its compiled workspace and production deps).
# QAre runs nare from PATH: the base image's pinned nare, which is the release this
# QAre pins (2026.11.135). QAre passes --contract, and nare refuses any contract but its
# own, so a nare pin that changes the contract moves with a QAre release that speaks it.
#
# 442: the pinned image is qare-web, not qare-core. qare-web is QAre's core image of the
# same release plus the browser driver family under /opt/qare/drivers/web: the Chromium
# build QAre's own playwright-core resolves. Its layers begin with exactly the qare-core
# layers of that release, so /opt/qare is core's tree plus drivers/web, and the browser
# always matches the QAre it ships with.
#
# Bumping QAre is one change: set QARE_VERSION below, set this tag to the same release and
# the digest to that tag's index digest (for example `docker buildx imagetools inspect
# ghcr.io/vividynamics/qare-web:<release>`), and keep stage_providers.<name>.version equal
# to QARE_VERSION. The build checks the version and launches the browser, so a wrong pin
# fails CI's image build.
ARG QARE_IMAGE=ghcr.io/vividynamics/qare-web:2026.11.45@sha256:e80d8d4c3a99ffff06946bffd10c16f00058750adb85112f7da7e0fe9e8e23c9
FROM ${QARE_IMAGE} AS qare

FROM $BASE_IMAGE

# Build-only: extra tools must preserve the base image's locked runtime.
ARG PIP_CONSTRAINT=/opt/performer-constraints.txt

# Install Playwright + Chromium for browser automation.
# Retry the browser download: cdn.playwright.dev intermittently times out
# ("Download failure, code=1") and would otherwise fail the whole image build —
# a transient CDN flake, not a code error. Retry up to 5x, then fail loudly.
RUN pip install --no-cache-dir playwright && \
    n=0; until playwright install --with-deps chromium; do \
      n=$((n+1)); \
      if [ "$n" -ge 5 ]; then echo "playwright install failed after $n attempts" >&2; exit 1; fi; \
      echo "playwright download failed (attempt $n/5); retrying in 15s..." >&2; sleep 15; \
    done

# Install cross-language linters, formatters, and test runners
# Python tools
#
# semgrep and bandit run the mandatory prose security floor inside the
# performer (107). Its runtime report gates the daemon's security verdict.
# A custom image without either tool holds the security stage closed.
RUN pip install --no-cache-dir \
    bandit \
    black \
    isort \
    pylint \
    pytest \
    ruff \
    "semgrep>=1.182.1"

# Node.js tools (installed globally via npm)
RUN npm install -g \
    eslint \
    prettier \
    jest

# Generic tools for shell/bash
RUN apt-get update && apt-get install -y --no-install-recommends \
    shellcheck \
    && rm -rf /var/lib/apt/lists/*

# 423: the stage provider CLIs. Coordinare runs QAre (QA) and Progettare (architect) as
# stage jobs in this image (`python -m performer.stage_jobs`), so its own host never
# clones. Their versions must equal stage_providers.<name>.version in the config.
#
# gh: Progettare reads the issue through it.
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
       -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
       > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version

# QAre, from the digest-pinned image above.
ARG QARE_VERSION=2026.11.45
COPY --from=qare /opt/qare /opt/qare
RUN ln -s /opt/qare/bin/qare /usr/local/bin/qare \
    && test "$(qare --version)" = "${QARE_VERSION}"

# 442: QAre's browser. QAre drives browsers through its own playwright-core, which
# launches only the Chromium revision of its release. The browsers came with /opt/qare
# above, under /opt/qare/drivers/web/browsers (QAre's contract path). What qare-web
# installed beside them on its own base is the system libraries, so they are installed
# here by that same playwright-core, plus Xvfb and GTK 3 for QAre's Electron driver, as
# qare-web does.
#
# The Python Playwright Chromium above stays: the performer's own QA workflow and agents
# use it. It is unpinned, so its revision moves with each Python Playwright release, and
# neither revision satisfies the other Playwright. Both live in Playwright's default
# cache (root's, ~/.cache/ms-playwright), side by side as revision directories: QAre's
# are linked in, with QAre's .links entry, so each Playwright finds its own and a later
# `playwright install` keeps QAre's. No PLAYWRIGHT_BROWSERS_PATH is set anywhere: QAre
# passes its environment to every check and app it starts, and a path there would hide
# the other revision from them.
RUN apt-get update \
    && node /opt/qare/lib/packages/core/node_modules/playwright-core/cli.js install-deps chromium \
    && apt-get install -y --no-install-recommends xvfb libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu \
    && cache=/root/.cache/ms-playwright \
    && qare_browsers=/opt/qare/drivers/web/browsers \
    && mkdir -p "${cache}/.links" \
    && for dir in "${qare_browsers}"/*/; do \
         [ -d "${dir}" ] || { echo "no browser directories under ${qare_browsers}" >&2; exit 1; }; \
         name="$(basename "${dir}")"; \
         if [ ! -e "${cache}/${name}" ] && [ ! -L "${cache}/${name}" ]; then ln -s "${dir%/}" "${cache}/${name}"; fi; \
       done \
    && for link in "${qare_browsers}"/.links/*; do \
         [ -f "${link}" ] || { echo "no Playwright .links entry under ${qare_browsers}" >&2; exit 1; }; \
         target="$(cat "${link}")"; \
         [ -f "${target}/browsers.json" ] || { echo "${link} names ${target}, which has no browsers.json" >&2; exit 1; }; \
         cp "${link}" "${cache}/.links/"; \
       done \
    && playwright install chromium
# The Python `playwright install` just above finds Chromium already installed, and first
# runs Playwright's cache cleanup, which deletes revisions no .links entry names: QAre's
# survive it only if its entry is right, and the check below would fail if not.
#
# The build-time browser check, in a clean environment like the one the stage job gives
# QAre (HOME and PATH, no browser path): QAre's playwright-core must be the version its
# browsers were installed for, resolve Chromium in the default cache (the path QAre's
# doctor checks), launch it headless (which runs the headless shell QAre's flows use) and
# load about:blank. The Python Playwright must still launch its own Chromium the same
# way. Anything else fails CI's image build.
RUN env -i PATH="${PATH}" HOME=/root node -e ' \
         const fs = require("fs"); \
         const root = "/opt/qare/lib/packages/core/node_modules/playwright-core"; \
         const pw = require(root); \
         const have = require(root + "/package.json").version; \
         const driver = JSON.parse(fs.readFileSync("/opt/qare/drivers/web/DRIVER.json", "utf8")); \
         if (have !== driver.drivers.chromium) { \
           throw new Error("QAre playwright-core " + have + ", browsers for " + driver.drivers.chromium); \
         } \
         const exe = pw.chromium.executablePath(); \
         if (!exe.startsWith("/root/.cache/ms-playwright/") || !fs.existsSync(exe)) { \
           throw new Error("QAre Chromium not found in the default cache: " + exe); \
         } \
         (async () => { \
           const browser = await pw.chromium.launch({ headless: true }); \
           const page = await browser.newPage(); \
           await page.goto("about:blank"); \
           const url = page.url(); \
           const version = browser.version(); \
           await browser.close(); \
           if (url !== "about:blank") throw new Error("loaded " + url); \
           console.log("QAre playwright-core " + have + " launched Chromium " + version + " headless and loaded " + url); \
         })().catch((err) => { console.error(err); process.exit(1); }); \
       ' \
    && env -i PATH="${PATH}" HOME=/root python3 -c 'from playwright.sync_api import sync_playwright; \
p = sync_playwright().start(); b = p.chromium.launch(headless=True); pg = b.new_page(); pg.goto("about:blank"); \
assert pg.url == "about:blank", pg.url; print("Python Playwright launched Chromium " + b.version + " headless"); \
b.close(); p.stop()'

# Progettare, as its release installer installs it (a uv tool with its own,
# release-matched nare), from wheels checked against their SHA-256 (nare's is the one in
# its release notes). Its own virtualenv: nothing here meets the performer's constraints.
ARG PROGETTARE_VERSION=2026.11.2
ARG PROGETTARE_SHA256=6e268fe3a599aaebf458e9170184825e78269f27f596d9064a00b3052b11f2a2
ARG PROGETTARE_NARE_VERSION=2026.11.113
ARG PROGETTARE_NARE_SHA256=802ad5c1c952683f809beb9322858e983e583bd9a43ee1721cf57520852d7b71
RUN set -eu \
    && base=https://github.com/ViviDynamics \
    && wheel="progettare-${PROGETTARE_VERSION}-py3-none-any.whl" \
    && nare_wheel="nare-${PROGETTARE_NARE_VERSION}-py3-none-any.whl" \
    && curl -fsSL -o "/tmp/${wheel}" "${base}/progettare/releases/download/${PROGETTARE_VERSION}/${wheel}" \
    && curl -fsSL -o "/tmp/${nare_wheel}" "${base}/nare/releases/download/${PROGETTARE_NARE_VERSION}/${nare_wheel}" \
    && echo "${PROGETTARE_SHA256}  /tmp/${wheel}" | sha256sum -c - \
    && echo "${PROGETTARE_NARE_SHA256}  /tmp/${nare_wheel}" | sha256sum -c - \
    && env -u PIP_CONSTRAINT UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin UV_PYTHON_DOWNLOADS=never \
       uv tool install --python 3.12 --with "/tmp/${nare_wheel}" "/tmp/${wheel}" \
    && rm -f "/tmp/${wheel}" "/tmp/${nare_wheel}" \
    && test "$(progettare --version)" = "${PROGETTARE_VERSION}" \
    && test "$(/opt/uv-tools/progettare/bin/nare --version)" = "${PROGETTARE_NARE_VERSION}"

# Auto-source mounted env-cache activate.sh in every shell spawned by agent
# CLI tool calls. Different backends spawn shells differently:
#   - codex uses `bash -lc` (login)        → sources /etc/profile → /etc/profile.d/*
#   - claude/opencode/cursor/junie may use `bash -c` or `sh -c` (non-login,
#     non-interactive) → neither /etc/profile nor /etc/bash.bashrc is read.
# Bash/dash honor BASH_ENV/ENV for non-interactive shells, so we set both to
# our activation script. The /etc/profile.d/ install also covers login shells
# (where BASH_ENV is ignored).
COPY devenv-profile.sh /etc/profile.d/zz-devenv.sh
RUN chmod 0644 /etc/profile.d/zz-devenv.sh && \
    ln -sf /etc/profile.d/zz-devenv.sh /etc/devenv-activate.sh
ENV BASH_ENV=/etc/devenv-activate.sh \
    ENV=/etc/devenv-activate.sh

# Backend CLI is installed at container start by entrypoint.sh based on $BACKEND.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Ensure ~/.local/bin is in PATH for backends that install to ~/.local/bin (cursor, opencode)
ENV PATH="/root/.local/bin:${PATH}"

ENTRYPOINT ["/entrypoint.sh"]
