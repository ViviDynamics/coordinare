ARG BASE_IMAGE=coordinare-performer:base
FROM $BASE_IMAGE

# Build-only: extra tools must preserve the base image's locked runtime.
ARG PIP_CONSTRAINT=/opt/performer-constraints.txt

# Install Playwright + Chromium for browser automation.
# Retry the browser download: cdn.playwright.dev intermittently times out
# ("Download failure, code=1") and would otherwise fail the whole image build —
# a transient CDN flake, not a code error. Retry up to 5x, then fail loudly.
RUN pip install --no-cache-dir playwright && \
    n=0; until playwright install --with-deps chromium; do \
      n=$((n+1)); \
      if [ "$n" -ge 5 ]; then echo "playwright install failed after $n attempts" >&2; exit 1; fi; \
      echo "playwright download failed (attempt $n/5); retrying in 15s..." >&2; sleep 15; \
    done

# Install cross-language linters, formatters, and test runners
# Python tools
#
# semgrep and bandit run the mandatory prose security floor inside the
# performer (107). Its runtime report gates the daemon's security verdict.
# A custom image without either tool holds the security stage closed.
RUN pip install --no-cache-dir \
    bandit \
    black \
    isort \
    pylint \
    pytest \
    ruff \
    "semgrep>=1.182.1"

# Node.js tools (installed globally via npm)
RUN npm install -g \
    eslint \
    prettier \
    jest

# Generic tools for shell/bash
RUN apt-get update && apt-get install -y --no-install-recommends \
    shellcheck \
    && rm -rf /var/lib/apt/lists/*

# Auto-source mounted env-cache activate.sh in every shell spawned by agent
# CLI tool calls. Different backends spawn shells differently:
#   - codex uses `bash -lc` (login)        → sources /etc/profile → /etc/profile.d/*
#   - claude/opencode/cursor/junie may use `bash -c` or `sh -c` (non-login,
#     non-interactive) → neither /etc/profile nor /etc/bash.bashrc is read.
# Bash/dash honor BASH_ENV/ENV for non-interactive shells, so we set both to
# our activation script. The /etc/profile.d/ install also covers login shells
# (where BASH_ENV is ignored).
COPY devenv-profile.sh /etc/profile.d/zz-devenv.sh
RUN chmod 0644 /etc/profile.d/zz-devenv.sh && \
    ln -sf /etc/profile.d/zz-devenv.sh /etc/devenv-activate.sh
ENV BASH_ENV=/etc/devenv-activate.sh \
    ENV=/etc/devenv-activate.sh

# Backend CLI is installed at container start by entrypoint.sh based on $BACKEND.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Ensure ~/.local/bin is in PATH for backends that install to ~/.local/bin (cursor, opencode)
ENV PATH="/root/.local/bin:${PATH}"

ENTRYPOINT ["/entrypoint.sh"]
