#!/usr/bin/env python3
"""Advance the CalVer version in ./version based on today's date.

Rules:
  - New day  → YYYY.MM.DD          (N resets; no suffix needed)
  - Same day → YYYY.MM.DD.N+1      (increment the build counter)

Examples:
  2026.05.05        + same day  →  2026.05.05.1
  2026.05.05.1      + same day  →  2026.05.05.2
  2026.05.05.3      + new day   →  2026.05.06
"""
import re
import sys
from datetime import date

CALVER_RE = re.compile(r"^(\d{4})\.(\d{2})\.(\d{2})(?:\.(\d+))?$")

with open("version") as f:
    current = f.read().strip()

m = CALVER_RE.match(current)
if not m:
    print(f"ERROR: '{current}' in version file is not valid CalVer (YYYY.MM.DD[.N])", file=sys.stderr)
    sys.exit(1)

today = date.today()
today_str = today.strftime("%Y.%m.%d")
version_date = f"{m.group(1)}.{m.group(2)}.{m.group(3)}"

if version_date == today_str:
    n = int(m.group(4)) if m.group(4) is not None else 0
    new_version = f"{today_str}.{n + 1}"
else:
    new_version = today_str

with open("version", "w") as f:
    f.write(new_version + "\n")

print(f"{current} → {new_version}")
