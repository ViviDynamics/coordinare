#!/usr/bin/env bash
# Install the checkout as a login service using the shared service manager.
# Usage: bin/install [--env FILE] [--config FILE] [daemon options...]
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
export PYTHONPATH="${ROOT_DIR}/src:${PYTHONPATH:-}"
exec uv run python -m coordinare.service_dev "$@"
