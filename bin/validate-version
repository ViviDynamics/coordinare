#!/usr/bin/env python3
"""Validate that the CalVer version string in ./version is well-formed and unpublished.

CalVer format: YYYY.MM.DD  (e.g. 2026.05.05)
Optional patch suffix for same-day releases: YYYY.MM.DD.N  (e.g. 2026.05.05.1)

Checks:
  1. Format matches the pattern (zero-padded month/day, valid date).
  2. Version is not already a tag in the remote repository.
  3. Version is not older than the latest existing tag.
"""
import re
import subprocess
import sys
from datetime import date


CALVER_RE = re.compile(r"^(\d{4})\.(\d{2})\.(\d{2})(?:\.(\d+))?$")


def parse_calver(v: str) -> tuple[int, ...]:
    m = CALVER_RE.match(v)
    if not m:
        raise ValueError(f"'{v}' does not match CalVer format YYYY.MM.DD[.N]")
    year, month, day = int(m.group(1)), int(m.group(2)), int(m.group(3))
    patch = int(m.group(4)) if m.group(4) is not None else 0
    # Validate it's a real calendar date.
    try:
        date(year, month, day)
    except ValueError as exc:
        raise ValueError(f"'{v}' is not a valid date: {exc}") from exc
    return (year, month, day, patch)


with open("version") as f:
    current_version = f.read().strip()

print(f"Current version from file: {current_version}")

try:
    current_tuple = parse_calver(current_version)
except ValueError as exc:
    print(f"ERROR: {exc}", file=sys.stderr)
    sys.exit(1)

# Fetch remote tags (ignore errors on fresh repos with no tags yet).
try:
    tags_output = subprocess.check_output(
        ["git", "ls-remote", "--tags"], stderr=subprocess.DEVNULL
    )
    remote_tags = [
        t.split("refs/tags/")[1].strip()
        for t in tags_output.decode().split("\n")
        if "refs/tags/" in t and "^{}" not in t
    ]
except subprocess.CalledProcessError:
    remote_tags = []

if not remote_tags:
    print(f"No remote tags found — accepting {current_version} as first release.")
else:
    # Only consider tags that match CalVer format (ignore semver legacy tags, etc.).
    calver_tags = []
    for tag in remote_tags:
        try:
            calver_tags.append((parse_calver(tag), tag))
        except ValueError:
            pass

    if current_version in remote_tags:
        print(
            f"ERROR: Version {current_version} already exists as a tag in the remote repository.",
            file=sys.stderr,
        )
        sys.exit(1)

    if calver_tags:
        latest_tuple, latest_tag = max(calver_tags, key=lambda x: x[0])
        if current_tuple <= latest_tuple:
            print(
                f"ERROR: Current version ({current_version}) is not newer than "
                f"the latest tag ({latest_tag}).",
                file=sys.stderr,
            )
            sys.exit(1)

print(f"All version checks passed for version {current_version}")
