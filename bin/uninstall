#!/usr/bin/env bash
# Remove the user service, retaining config and state, then clean up manual runs.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
export PYTHONPATH="${ROOT_DIR}/src:${PYTHONPATH:-}"
uv run python -m coordinare service uninstall
"${ROOT_DIR}/bin/stop"
