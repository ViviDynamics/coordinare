#!/usr/bin/env bash
# bin/build — run the same checks as CI locally.
#
# Usage:
#   bin/build           # lint + coordinare tests + coverage + performer tests
#   bin/build --e2e     # also run Playwright browser tests
#   bin/build --docker  # also build and verify Docker images
#   bin/build --all     # everything (--e2e + --docker)
#
# Exit code is non-zero if any step fails.

set -euo pipefail

cd "$(dirname "$0")/.."

# ---------------------------------------------------------------------------
# Flags
# ---------------------------------------------------------------------------
RUN_E2E=0
RUN_DOCKER=0

for arg in "$@"; do
  case "$arg" in
    --e2e)    RUN_E2E=1 ;;
    --docker) RUN_DOCKER=1 ;;
    --all)    RUN_E2E=1; RUN_DOCKER=1 ;;
    *)
      echo "Unknown option: $arg"
      echo "Usage: bin/build [--e2e] [--docker] [--all]"
      exit 1
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
PASS="\033[0;32m✓\033[0m"
FAIL="\033[0;31m✗\033[0m"
STEP="\033[0;34m▶\033[0m"
SKIP="\033[0;33m–\033[0m"

step() { echo -e "\n$STEP $1"; }
ok()   { echo -e "$PASS $1"; }
skip() { echo -e "$SKIP $1 (skipped)"; }

FAILED=()
run() {
  local label="$1"; shift
  step "$label"
  if "$@"; then
    ok "$label"
  else
    echo -e "$FAIL $label"
    FAILED+=("$label")
  fi
}

# ---------------------------------------------------------------------------
# Steps
# ---------------------------------------------------------------------------

# Install both packages before collecting either suite. Coordinare tests import
# performer backends, including their runtime dependencies. Keep uv from syncing
# the root project again and removing the separately installed performer.
step "Install coordinare and performer development dependencies"
uv sync --extra dev
uv pip install -e "agent/performer[dev]"

PYTEST=(env -u COORDINARE_INFERENCE_MAX_TOKENS -u HERMES_CONTEXT_WINDOW
        uv run --no-sync pytest)

run "Lint (ruff)" \
  uv run --no-sync ruff check src tests agent/performer/src

run "Ruff baseline (432 ratchet)" \
  uv run --no-sync python scripts/ruff_baseline.py

run "Typecheck (433 ratchet)" \
  uv run --no-sync mypy -p coordinare

run "Coordinare tests" \
  "${PYTEST[@]}" tests/ -q

run "Coverage (≥ 90%)" \
  "${PYTEST[@]}" tests/ \
    --cov=coordinare --cov-report=term-missing --cov-fail-under=90 -q

run "Performer tests" \
  "${PYTEST[@]}" agent/performer/tests/ -q

if [[ $RUN_E2E -eq 1 ]]; then
  run "Install Playwright browsers" \
    uv run --no-sync playwright install --with-deps chromium firefox

  run "E2E browser tests" \
    "${PYTEST[@]}" tests/e2e/ \
      --override-ini="addopts=" --browser chromium --browser firefox -v
else
  skip "E2E browser tests (pass --e2e to enable)"
fi

if [[ $RUN_DOCKER -eq 1 ]]; then
  run "Docker: build base image" \
    docker build -t coordinare-performer:base \
      -f agent/performer/Dockerfile.base .

  run "Docker: build full image" \
    docker build -t coordinare-performer:full \
      -f agent/performer/Dockerfile.full agent/performer/

  # :extra layers system browsers ON TOP of :full for browser-driven QA, and is
  # the image the qa (claude-ephemeral) performer runs. It MUST be rebuilt with
  # :full so it carries the same performer code — otherwise a routing.yaml schema
  # change (e.g. a new TargetDescriptor field) makes the stale :extra reject the
  # table and the qa stage fails to dispatch (card blocked at qa). FROM :full, so
  # it builds after it.
  run "Docker: build extra image" \
    docker build -t coordinare-performer:extra \
      -f agent/performer/Dockerfile.extra agent/performer/

  step "Docker: verify image size gap (SC-007)"
  if python3 - <<'EOF'
import subprocess, json
base = int(json.loads(subprocess.check_output(
  ["docker", "inspect", "--format", "{{json .Size}}", "coordinare-performer:base"])))
full = int(json.loads(subprocess.check_output(
  ["docker", "inspect", "--format", "{{json .Size}}", "coordinare-performer:full"])))
gap = full - base
print(f"  base={base/1e6:.0f} MB  full={full/1e6:.0f} MB  gap={gap/1e6:.0f} MB")
assert gap >= 150_000_000, f"SC-007 FAIL: gap {gap/1e6:.0f} MB < 150 MB"
print("  SC-007 PASS")
EOF
  then
    ok "Docker: image size gap (SC-007)"
  else
    echo -e "$FAIL Docker: image size gap (SC-007)"
    FAILED+=("Docker: image size gap (SC-007)")
  fi

  step "Docker: verify rtk binary in base image (062 Fix 2)"
  if docker run --rm --entrypoint rtk coordinare-performer:base --version >/dev/null 2>&1; then
    ok "Docker: rtk binary present"
  else
    echo -e "$FAIL Docker: rtk binary missing or non-functional in base image"
    FAILED+=("Docker: rtk binary")
  fi

  step "Docker: rtk compression wrapper actually compresses (062 Fix 2)"
  # Compare byte counts: rtk's compressed output for `ls -la /` must be
  # strictly smaller than plain `ls -la /`. If rtk silently passes through
  # (or no-ops because the proxy regressed), this fails and we know the
  # measurement run would be contaminated.
  if docker run --rm --entrypoint sh coordinare-performer:base -c '
    set -e
    rtk ls -la / >/tmp/rtk.out 2>/dev/null
    ls -la / >/tmp/plain.out 2>/dev/null
    rtk_bytes=$(wc -c </tmp/rtk.out)
    plain_bytes=$(wc -c </tmp/plain.out)
    test "$rtk_bytes" -gt 0
    test "$rtk_bytes" -lt "$plain_bytes"
    echo "rtk=${rtk_bytes}B plain=${plain_bytes}B"
  '; then
    ok "Docker: rtk wrapper produces smaller output than plain command"
  else
    echo -e "$FAIL Docker: rtk wrapper did not compress (output >= plain)"
    FAILED+=("Docker: rtk compression")
  fi

  step "Docker: rtk init -g writes hook files (062 Fix 2)"
  # Drive `rtk init -g` inside the container against a stub HOME with a
  # pre-created .claude dir (rtk init requires it). Assert the three
  # artefacts it advertises actually land on disk: RTK.md, CLAUDE.md
  # @reference, and the filters.toml template.
  if docker run --rm --entrypoint sh coordinare-performer:base -c '
    set -e
    mkdir -p /tmp/h/.claude
    HOME=/tmp/h rtk init -g >/dev/null 2>&1
    test -f /tmp/h/.claude/RTK.md
    test -f /tmp/h/.claude/CLAUDE.md
    grep -q "@RTK.md" /tmp/h/.claude/CLAUDE.md
    test -f /tmp/h/.config/rtk/filters.toml
  '; then
    ok "Docker: rtk init -g writes expected hook files"
  else
    echo -e "$FAIL Docker: rtk init -g did not write expected hook files"
    FAILED+=("Docker: rtk init -g hook files")
  fi

  step "Docker: :full and :extra parse routing.example.yaml (schema drift guard)"
  # The performer-side RoutingTable loader must accept the routing table the
  # running deployment mounts. routing.example.yaml is the in-repo template and
  # exercises every supported field (incl. 099 health_probe). If a code/schema
  # change lands in :full but :extra is stale (or vice versa), the qa performer
  # rejects the table at job start and the card blocks at qa — this catches that.
  routing_drift_ok=1
  for img in full extra; do
    if ! docker run --rm \
        -v "$PWD/routing.example.yaml:/etc/coordinare/routing.yaml:ro" \
        --entrypoint python "coordinare-performer:$img" -c \
        'from performer.proxy.routing import RoutingTable; RoutingTable.from_yaml_file("/etc/coordinare/routing.yaml")' \
        >/dev/null 2>&1; then
      echo -e "$FAIL Docker: coordinare-performer:$img cannot parse routing.example.yaml (stale schema)"
      routing_drift_ok=0
    fi
  done
  if [[ $routing_drift_ok -eq 1 ]]; then
    ok "Docker: :full and :extra parse routing.example.yaml"
  else
    FAILED+=("Docker: routing.example.yaml schema drift")
  fi
else
  skip "Docker image builds (pass --docker to enable)"
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
if [[ ${#FAILED[@]} -eq 0 ]]; then
  echo -e "\033[0;32m✓ All checks passed.\033[0m"
  exit 0
else
  echo -e "\033[0;31m✗ Failed:\033[0m"
  for f in "${FAILED[@]}"; do
    echo "  - $f"
  done
  exit 1
fi
