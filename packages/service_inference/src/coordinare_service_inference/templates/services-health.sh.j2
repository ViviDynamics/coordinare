#!/usr/bin/env bash
# Auto-generated by coordinare service inference (spec 063). Do not edit by hand.
# Manifest agent_version: {{ agent_version }}
#
# Exit 0 if all in-container services are healthy and all external services have
# their connection env vars present. Non-zero on any failure; the performer
# bootstrap-result protocol propagates this back to the env-cache service for
# self-healing (spec 063 Phase 4).
#
# REQUIRES: bash with /dev/tcp support enabled (the upstream default on bash >=2,
# but distros that compile with --disable-net-redirections — alpine's `bash` on
# some images, dash, ash — will not work). The performer image ships GNU bash
# with this feature; if you swap the base image, verify `bash -c 'exec 3<>/dev/tcp/127.0.0.1/22; exec 3>&-'`
# returns 0 (or refuses the connection — both indicate the feature is compiled in).
set -u

_fail() {
  echo "health: FAIL — $*" >&2
  exit 1
}

_port_open() {
  local port="$1"
  if (exec 3<>/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
    exec 3>&-; exec 3<&-
    return 0
  fi
  return 1
}

{% for svc in services %}
{% if svc.external_required %}
{% for env_var in svc.required_env_vars %}
[ -n "${{ '{' }}{{ env_var }}:-{{ '}' }}" ] || _fail "external service {{ svc.name }}: missing env var {{ env_var }}"
{% endfor %}
echo "ok: {{ svc.name }} (external; env vars present)"
{% else %}
if _port_open "{{ svc.port }}"; then
  echo "ok: {{ svc.name }} listening on {{ svc.port }}"
else
  _fail "{{ svc.name }} not listening on port {{ svc.port }}"
fi
{% endif %}
{% endfor %}

echo "services-health: all ok"
exit 0
