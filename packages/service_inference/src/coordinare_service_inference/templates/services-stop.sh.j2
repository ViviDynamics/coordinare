#!/usr/bin/env bash
# Auto-generated by coordinare service inference (spec 063). Do not edit by hand.
# Manifest agent_version: {{ agent_version }}
set -u

SERVICES_DIR="${XDG_RUNTIME_DIR:-/tmp}/coordinare-services"

_stop_pid() {
  local pid_file="$1"
  local name="$2"
  [ -f "$pid_file" ] || { echo "info: $name not running (no pid file)"; return 0; }
  local pid
  pid=$(cat "$pid_file" 2>/dev/null) || return 0
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$pid_file"
    echo "info: $name not running (stale pid file removed)"
    return 0
  fi
  echo "info: sending SIGTERM to $name (pid $pid)"
  kill -TERM "$pid" 2>/dev/null || true
  local i=0
  while [ $i -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
    sleep 0.5
    i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "warn: $name did not exit; sending SIGKILL"
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
}

{% for svc in services %}
{% if not svc.external_required %}
{% if svc.kind == "postgres" %}
# Clean fast shutdown so the next start needs no crash recovery; a bare SIGTERM triggers
# postgres "smart" shutdown (waits for clients) and the SIGKILL fallback forces recovery.
{{ svc.name | upper }}_DATA_DIR="$SERVICES_DIR/{{ svc.name }}-data"
if [ -d "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/base" ] || [ -f "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/postmaster.pid" ]; then
  pg_ctl stop -m fast -D "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" >/dev/null 2>&1 || true
fi
rm -f "$SERVICES_DIR/{{ svc.name }}.pid"
echo "info: stopped {{ svc.name }} (pg_ctl fast)"
{% elif svc.kind == "mysql" %}
# mariadbd runs under runuser as mysqlrunner: killing the runuser pid does not
# necessarily stop the daemon. Signal this service's recorded pid first, then
# scope the user-level sweep to THIS service by its data dir (which appears in
# mariadbd's argv) — a second kind:mysql service sharing the account must never
# be collateral (review 475 round 2).
_stop_pid "$SERVICES_DIR/{{ svc.name }}.pid" "{{ svc.name }}"
pkill -TERM -u mysqlrunner -f "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" 2>/dev/null || true
{% elif svc.kind == "elasticsearch" %}
# elasticsearch runs under runuser as esrunner. Same scoping rule: kill the
# recorded pid, then sweep the user's processes only where the unique
# http.port=<this service's port> appears in the JVM argv (review 475 r2).
_stop_pid "$SERVICES_DIR/{{ svc.name }}.pid" "{{ svc.name }}"
pkill -TERM -u esrunner -f "http.port=${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" 2>/dev/null || true
{% else %}
_stop_pid "$SERVICES_DIR/{{ svc.name }}.pid" "{{ svc.name }}"
{% endif %}
{% endif %}
{% endfor %}

echo "services-stop: complete"
