#!/usr/bin/env bash
# Auto-generated by coordinare service inference (spec 063). Do not edit by hand.
# Manifest agent_version: {{ agent_version }}
set -u

SERVICES_DIR="${XDG_RUNTIME_DIR:-/tmp}/coordinare-services"

_stop_pid() {
  local pid_file="$1"
  local name="$2"
  [ -f "$pid_file" ] || { echo "info: $name not running (no pid file)"; return 0; }
  local pid
  pid=$(cat "$pid_file" 2>/dev/null) || return 0
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$pid_file"
    echo "info: $name not running (stale pid file removed)"
    return 0
  fi
  echo "info: sending SIGTERM to $name (pid $pid)"
  kill -TERM "$pid" 2>/dev/null || true
  local i=0
  while [ $i -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
    sleep 0.5
    i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "warn: $name did not exit; sending SIGKILL"
    kill -KILL "$pid" 2>/dev/null || true
  fi
  rm -f "$pid_file"
}

{% for svc in services %}
{% if not svc.external_required %}
_stop_pid "$SERVICES_DIR/{{ svc.name }}.pid" "{{ svc.name }}"
{% endif %}
{% endfor %}

echo "services-stop: complete"
