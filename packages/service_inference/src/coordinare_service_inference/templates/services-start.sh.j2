#!/usr/bin/env bash
# Auto-generated by coordinare service inference (spec 063). Do not edit by hand.
# Manifest agent_version: {{ agent_version }}
#
# Idempotent under partial failure: re-invocation after a mid-startup crash will
# detect already-running PIDs via `kill -0` and skip already-bound ports.
set -u
set -o pipefail

SERVICES_DIR="${XDG_RUNTIME_DIR:-/tmp}/coordinare-services"
mkdir -p "$SERVICES_DIR"

_is_running() {
  local pid_file="$1"
  [ -f "$pid_file" ] || return 1
  local pid
  pid=$(cat "$pid_file" 2>/dev/null) || return 1
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

_port_bound() {
  local port="$1"
  # Prefer /proc when available (no extra deps); fall back to bash tcp probe.
  # Match ONLY a socket in the LISTEN state (st field 0A) whose LOCAL port is
  # $hex_port — a LISTEN socket has an all-zero rem_address (0+:0000). Matching
  # ANY state here false-positives on the TIME_WAIT sockets a just-killed or
  # restarted server leaves behind (its served connections carry local port
  # $hex_port for ~60s): a re-run then "assumes external instance" and SKIPS
  # starting the service, so the app has no server to connect to. The /dev/tcp
  # fallback is likewise a real connect() — it only succeeds against a live
  # listener, never a TIME_WAIT — so both paths are teardown-safe.
  if [ -r /proc/net/tcp ]; then
    local hex_port
    hex_port=$(printf '%04X' "$port")
    grep -qE ":${hex_port} 0+:0000 0A" /proc/net/tcp /proc/net/tcp6 2>/dev/null && return 0
  fi
  exec 3<>/dev/tcp/127.0.0.1/"$port" 2>/dev/null && { exec 3>&- 3<&- 2>/dev/null; return 0; }
  return 1
}

_memcached_ready() {
  # memcached's wire protocol is plain text: `version` answers VERSION... — a
  # real protocol probe with no client binary required. The fd is opened in THIS
  # function's shell (not a subshell) so printf/read can use it (review 475).
  local port="$1" line
  exec 3<>/dev/tcp/127.0.0.1/"$port" 2>/dev/null || return 1
  printf 'version\r\n' >&3 2>/dev/null || { exec 3>&- 3<&- 2>/dev/null; return 1; }
  IFS= read -r -t 2 line <&3 || { exec 3>&- 3<&- 2>/dev/null; return 1; }
  exec 3>&- 3<&- 2>/dev/null
  case "$line" in
    VERSION*) return 0 ;;
    *) return 1 ;;
  esac
}

# spec 115: library search path for the coordinare-managed service binaries.
# The server binaries (postgres/redis) live in the cache's services-extract tree, and so do
# their shared libraries (e.g. libpq.so.5 under usr/lib/<arch>, postgres extension libs under
# usr/lib/postgresql/<NN>/lib). The performer profile only flattens *.so from <cache>/debs/
# onto the global LD_LIBRARY_PATH, and a fetch that lands the server's deps but not libpq5
# leaves libpq.so.5 absent — so the server tooling AND its client utilities fail to
# dynamically link and the cluster never comes up. Build a path from the extract tree,
# prepended onto the profile-set value, and export it FOR THIS SCRIPT.
# Exporting is safe here: services-start.sh is a one-shot bootstrap process — the
# application-under-test does NOT inherit this env (it gets a fresh shell that sources
# activate.sh), so this never shadows system libs at QA time; only the backgrounded service
# daemons we launch inherit it, which is exactly what must link against these libs at runtime.
_SVC_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
if [ -n "${DEVENV:-}" ]; then
  for _svc_lib in "$DEVENV"/services-extract/usr/lib/*-linux-gnu "$DEVENV"/services-extract/usr/lib/postgresql/*/lib; do
    [ -d "$_svc_lib" ] && _SVC_LD_LIBRARY_PATH="$_svc_lib:$_SVC_LD_LIBRARY_PATH"
  done
fi
# Covers the root-caller client utilities and the backgrounded daemons. `_pg_as` still passes
# it explicitly because `runuser` drops the inherited environment.
export LD_LIBRARY_PATH="$_SVC_LD_LIBRARY_PATH"

{% for svc in services %}
{% if svc.external_required %}
# --- {{ svc.name }} (external_required) ---
{% for env_var in svc.required_env_vars %}
if [ -z "${{ '{' }}{{ env_var }}:-{{ '}' }}" ]; then
  echo "ERROR: {{ svc.name }} requires env var {{ env_var }} (external service)" >&2
  exit 64
fi
{% endfor %}
echo "info: {{ svc.name }} is external; connection vars present"

{% else %}
# --- {{ svc.name }} ({{ svc.why_needed }}) ---
{{ svc.name | upper }}_PID_FILE="$SERVICES_DIR/{{ svc.name }}.pid"
{% if svc.kind == "postgres" %}
# Postgres state lives under the writable services root, never the (read-only) cache mount.
{{ svc.name | upper }}_DATA_DIR="$SERVICES_DIR/{{ svc.name }}-data"
{% else %}
{{ svc.name | upper }}_DATA_DIR={{ svc.data_dir | shq }}
{% endif %}
{{ svc.name | upper }}_PORT="{{ svc.port }}"

if _is_running "${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}"; then
  echo "info: {{ svc.name }} already running (pid $(cat ${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}))"
elif _port_bound "${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}"; then
  echo "info: {{ svc.name }} port ${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }} already bound; assuming external instance"
else
  mkdir -p "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}"
{% if svc.kind == "postgres" %}
{% set _su = svc.init.superuser if svc.init else 'postgres' %}
  # Postgres first-run init is coordinare-owned and idempotent: initdb (guarded by the
  # PG_VERSION sentinel) creates the cluster + superuser atomically; the server then binds
  # the declared port on loopback; each database is created create-if-missing so a re-run —
  # or a run that died mid-recipe — converges without error and without data loss.
  # spec 110: PGDATA is a SUBDIR of the service data dir so the coordinare-written
  # logs (initdb.log / postgres.log, in the parent) don't make PGDATA non-empty —
  # initdb refuses a non-empty target.
  _PGDATA="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/pgdata"
  _PGPORT="${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}"
  # spec 110: postgres REFUSES to run as root (initdb/postgres abort). The performer
  # container is root, so run the server tooling as a dedicated unprivileged user.
  # Create it if absent, own the data dir, and run initdb/postgres via `runuser`
  # preserving the profile-set PATH and the spec-115 service-scoped LD_LIBRARY_PATH (so the
  # cached postgres binaries and their libs — e.g. libpq.so.5, libicu — resolve under the
  # dropped user). pg_isready/createdb are clients and stay as the (root) caller.
  _PGUSER=pgrunner
  id "$_PGUSER" >/dev/null 2>&1 || useradd -r -M -s /usr/sbin/nologin "$_PGUSER" 2>/dev/null || true
  mkdir -p "$_PGDATA"
  chown -R "$_PGUSER" "$_PGDATA" 2>/dev/null || true
  _pg_as() { runuser -u "$_PGUSER" -- env PATH="$PATH" LD_LIBRARY_PATH="$_SVC_LD_LIBRARY_PATH" "$@"; }
  if [ ! -f "$_PGDATA/PG_VERSION" ]; then
{% if svc.init and svc.init.password_env_var %}
    # The declared admin secret's env var must be PRESENT at init time (it may legitimately
    # be empty). Under `set -u` a genuinely-unset var would otherwise abort with a cryptic
    # "unbound variable"; distinguish "unset" (a real misconfiguration: surface a clear
    # environment-attributed exit 75) from "set but empty" (an intentional passwordless
    # cluster — the test-env declared the var but left its value blank).
    if [ -z "${{ '{' }}{{ svc.init.password_env_var }}+x{{ '}' }}" ]; then
      echo "ERROR: env: {{ svc.name }} requires env var {{ svc.init.password_env_var }} (the admin secret) but it is unset" >&2
      exit 75
    elif [ -z "${{ '{' }}{{ svc.init.password_env_var }}{{ '}' }}" ]; then
      # Declared but empty: the test-env intentionally requests a passwordless cluster.
      # Initialize with trust auth (no secret material) so the empty password is accepted
      # for both local and host connections.
      _pg_as initdb --no-sync --pgdata="$_PGDATA" --username={{ _su | shq }} --auth-local=trust --auth-host=trust >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/initdb.log" 2>&1
    else
      # Non-empty secret: md5 auth. The secret is never a literal here — it is passed to
      # the unprivileged init shell via the environment (never argv/disk); that shell reads
      # it through --pwfile=<(...) process substitution it creates itself (so the fd is
      # owned by the dropped user), so the value never lands in argv, logs, or on disk.
      runuser -u "$_PGUSER" -- env PATH="$PATH" LD_LIBRARY_PATH="$_SVC_LD_LIBRARY_PATH" _PGPW="${{ '{' }}{{ svc.init.password_env_var }}{{ '}' }}" bash -c 'initdb --no-sync --pgdata="$1" --username="$2" --auth-local=trust --auth-host=md5 --pwfile=<(printf '"'"'%s'"'"' "$_PGPW")' _ "$_PGDATA" {{ _su | shq }} >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/initdb.log" 2>&1
    fi
{% else %}
    # No password env var declared: trust-auth local init (no secret material).
    _pg_as initdb --no-sync --pgdata="$_PGDATA" --username={{ _su | shq }} --auth-local=trust --auth-host=trust >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/initdb.log" 2>&1
{% endif %}
  fi
  _pg_as {{ svc.binary | shq }} -D "$_PGDATA" -p "$_PGPORT" -k "$_PGDATA" -c listen_addresses=127.0.0.1 >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  echo $! > "${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}"
  # Same dead-daemon guard the other managed kinds get (review 475 round 2): a
  # postgres that exits at start is a START failure with its log tail, not a
  # misreported 180s readiness timeout.
  sleep 2
  if ! kill -0 "$(cat "${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}")" 2>/dev/null; then
    echo "ERROR: env: {{ svc.name }} daemon died at start (exit before readiness); log tail:" >&2
    tail -n 40 "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" >&2 2>/dev/null || true
    exit 75
  fi
  # Bounded readiness wait: postgres binds the port before it can serve, so probe the
  # connection target; a timeout is surfaced as an environment-attributed failure, not a hang.
  # spec 111: 180s (was 60s) — the data dir is ephemeral so initdb runs every container,
  # and under the loaded :extra bootstrap image initdb+start can exceed 60s, tripping a
  # false "not ready". initdb itself uses --no-sync (throwaway test cluster) to cut its time.
  _pg_wait=0
  while [ "$_pg_wait" -lt 180 ]; do
    if pg_isready -h 127.0.0.1 -p "$_PGPORT" >/dev/null 2>&1; then break; fi
    _pg_wait=$((_pg_wait + 1))
    sleep 1
  done
  if [ "$_pg_wait" -ge 180 ]; then
    echo "ERROR: env: {{ svc.name }} did not become ready within 180s" >&2
    tail -n 40 "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" >&2 2>/dev/null || true
    exit 75
  fi
{% if svc.init %}
{% for db in svc.init.databases %}
  # create-if-missing. The script runs without `set -e`, so a failed createdb would
  # otherwise be swallowed and the service reported "started" with the database absent —
  # QA would then fail as if the code under test were broken. Gate it explicitly and
  # attribute a creation failure to the environment (exit 75).
  if ! psql -h "$_PGDATA" -p "$_PGPORT" -U {{ _su | shq }} -lqt | cut -d'|' -f1 | grep -qw {{ db | shq }}; then
    if ! createdb -h "$_PGDATA" -p "$_PGPORT" -U {{ _su | shq }} {{ db | shq }}; then
      echo "ERROR: env: {{ svc.name }} failed to create database {{ db }}" >&2
      exit 75
    fi
  fi
{% endfor %}
{% endif %}
  echo "info: started {{ svc.name }} (pid $(cat ${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}))"
{% else %}
  # Issue 413: service-specific bootstrap is coordinare-owned per kind. Every launch is
  # followed by (1) a pid-liveness check after a short grace — a daemon that died at
  # start (bad flag, refuses root, missing init) is a START failure reported with its
  # log tail, never a silent "started" — and (2) a bounded, per-kind readiness wait on
  # a protocol-level probe. stdout/stderr are redirected so a `subprocess.communicate()`
  # caller does not hang on the daemon's inherited pipes; launched binaries inherit the
  # script-level LD_LIBRARY_PATH export above (spec 115).
  {% if svc.kind == "redis" %}
  {{ svc.binary | shq }} --port="${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" --dir="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% elif svc.kind == "mysql" %}
  _MYSQLDATA="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}"
  _MYSQLPORT="${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}"
  _MYSQLUSER=mysqlrunner
  id "$_MYSQLUSER" >/dev/null 2>&1 || useradd -r -M -s /usr/sbin/nologin "$_MYSQLUSER" 2>/dev/null || true
  chown -R "$_MYSQLUSER" "$_MYSQLDATA" 2>/dev/null || true
  _mysql_as() { runuser -u "$_MYSQLUSER" -- env PATH="$PATH" LD_LIBRARY_PATH="$_SVC_LD_LIBRARY_PATH" "$@"; }
  if [ ! -e "$_MYSQLDATA/ibdata1" ] && [ ! -f "$_MYSQLDATA/aria_log_control" ]; then
    # Single supported init for the mariadb packages we install; a failed init is
    # attributed loudly (log tail + exit 75) instead of swallowed by `|| true` —
    # otherwise the launch below runs against an uninitialized dir and readiness
    # times out with the real cause buried (review 475). The sentinel check makes
    # an init that left a usable dir (rc!=0 but datadir populated) survivable.
    if ! _mysql_as mariadb-install-db --datadir="$_MYSQLDATA" --skip-name-resolve >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/install-db.log" 2>&1 && [ ! -f "$_MYSQLDATA/aria_log_control" ]; then
      tail -n 40 "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/install-db.log" >&2
      echo "ERROR: env: {{ svc.name }} (mysql) first-run init failed (mariadb-install-db); see install-db.log above" >&2
      exit 75
    fi
  fi
  _mysql_as {{ svc.binary | shq }} --datadir="$_MYSQLDATA" --port="$_MYSQLPORT" --bind-address=127.0.0.1 --skip-name-resolve >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% elif svc.kind == "mongodb" %}
  {{ svc.binary | shq }} --dbpath="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" --port="${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" --bind_ip 127.0.0.1 >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% elif svc.kind == "rabbitmq" %}
  # RabbitMQ refuses to run as root: launch through a dedicated unprivileged
  # user with HOME/Mnesia/pid/log paths owned by it under the data dir
  # (review 475).
  _rabbitmquser=rabbitrunner
  id "$_rabbitmquser" >/dev/null 2>&1 || useradd -r -M -s /usr/sbin/nologin "$_rabbitmquser" 2>/dev/null || true
  mkdir -p "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/mnesia"
  chown -R "$_rabbitmquser" "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" 2>/dev/null || true
  runuser -u "$_rabbitmquser" -- env HOME="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" RABBITMQ_NODE_PORT="${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" RABBITMQ_MNESIA_BASE="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/mnesia" RABBITMQ_PID_FILE="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/rabbit.pid" LD_LIBRARY_PATH="$_SVC_LD_LIBRARY_PATH" {{ svc.binary | shq }} >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% elif svc.kind == "elasticsearch" %}
  _ESDATA="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}"
  id esrunner >/dev/null 2>&1 || useradd -r -M -s /usr/sbin/nologin esrunner 2>/dev/null || true
  chown -R esrunner "$_ESDATA" 2>/dev/null || true
  runuser -u esrunner -- env PATH="$PATH" LD_LIBRARY_PATH="$_SVC_LD_LIBRARY_PATH" ES_JAVA_OPTS="-Xms256m -Xmx512m" {{ svc.binary | shq }} -E http.port="${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" -E network.host=127.0.0.1 -E discovery.type=single-node -E xpack.security.enabled=false >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% elif svc.kind == "memcached" %}
  # -u nobody: the daemon is reachable by the test workload; keep it out of
  # root (review 475).
  {{ svc.binary | shq }} -p "${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" -U 0 -m 64 -u nobody >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% elif svc.kind == "minio" %}
  {{ svc.binary | shq }} server "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" --address "127.0.0.1:${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% else %}
  {{ (svc.start_args | map('shq') | join(' ')) }} >"${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" 2>&1 &
  {% endif %}
  echo $! > "${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}"
  sleep 2
  if ! kill -0 "$(cat "${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}")" 2>/dev/null; then
    echo "ERROR: env: {{ svc.name }} daemon died at start (exit before readiness); log tail:" >&2
    tail -n 40 "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" >&2 2>/dev/null || true
    exit 75
  fi
{% set budget = {"redis":30,"mysql":60,"mongodb":60,"rabbitmq":60,"elasticsearch":90,"memcached":15,"minio":30}.get(svc.kind, 30) %}
  _svc_wait=0
{% if svc.kind == "redis" %}
  # Protocol probe: redis-cli PING (a bound port alone is not readiness).
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    if redis-cli -h 127.0.0.1 -p "${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" PING 2>/dev/null | grep -q PONG; then break; fi
{% elif svc.kind == "mysql" %}
  # mariadb-admin/mysqladmin ping answers "is alive" whenever the server responds at
  # all (even on an access-denied handshake), so grep for it.
  _MYSQLADMIN="$(command -v mariadb-admin || command -v mysqladmin)"
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    if "$_MYSQLADMIN" -h 127.0.0.1 -P "$_MYSQLPORT" ping 2>&1 | grep -q "is alive"; then break; fi
{% elif svc.kind == "mongodb" %}
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    if mongosh --quiet --host 127.0.0.1 --port "${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}" --eval 'db.runCommand({ ping: 1 })' >/dev/null 2>&1; then break; fi
{% elif svc.kind == "rabbitmq" %}
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    # rabbitmq-diagnostics reads the Erlang cookie from HOME: run it as the
    # service user with the broker's HOME or a healthy broker fails the gate
    # (review 475 round 2).
    if runuser -u rabbitrunner -- env HOME="${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}" rabbitmq-diagnostics -q ping >/dev/null 2>&1; then break; fi
{% elif svc.kind == "elasticsearch" %}
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    if curl -fsS "http://127.0.0.1:${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}/_cluster/health?wait_for_status=yellow&timeout=2s" >/dev/null 2>&1; then break; fi
{% elif svc.kind == "memcached" %}
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    if _memcached_ready "${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}"; then break; fi
{% elif svc.kind == "minio" %}
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    if curl -fsS "http://127.0.0.1:${{ '{' }}{{ svc.name | upper }}_PORT{{ '}' }}/minio/health/live" >/dev/null 2>&1; then break; fi
{% else %}
  # Generic: the manifest's OWN health_command is authoritative (the schema REQUIRES
  # start_args + health_command for an in-container generic service).
  while [ "$_svc_wait" -lt {{ budget }} ]; do
    if {{ (svc.health_command | map('shq') | join(' ')) }} >/dev/null 2>&1; then break; fi
{% endif %}
    _svc_wait=$((_svc_wait + 1))
    sleep 1
  done
  if [ "$_svc_wait" -ge {{ budget }} ]; then
    echo "ERROR: env: {{ svc.name }} did not become ready within {{ budget }}s" >&2
    tail -n 40 "${{ '{' }}{{ svc.name | upper }}_DATA_DIR{{ '}' }}/{{ svc.name }}.log" >&2 2>/dev/null || true
    exit 75
  fi
  echo "info: started {{ svc.name }} (pid $(cat ${{ '{' }}{{ svc.name | upper }}_PID_FILE{{ '}' }}))"
{% endif %}
fi

{% endif %}
{% endfor %}

echo "services-start: complete"
