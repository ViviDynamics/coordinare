{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coordinare init answers",
  "type": "object",
  "additionalProperties": false,
  "description": "YAML mapping accepted by init --answers. All keys are optional because flags, environment, saved values and detected defaults may supply them. Semantic and live checks still run in init.",
  "properties": {
    "github_token": {
      "type": "string",
      "writeOnly": true,
      "description": "Prefer COORDINARE_INIT_GITHUB_TOKEN or GH_TOKEN; never publish a credential."
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "project_number": {
      "$ref": "#/$defs/positiveInteger"
    },
    "harness": {
      "enum": [
        "codex",
        "claude_code",
        "opencode"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "description": "Empty selects native provider; otherwise use an OpenAI-compatible base URL reachable from the chosen run mode. Do not embed credentials."
    },
    "api_key": {
      "type": "string",
      "writeOnly": true,
      "description": "Prefer the provider API key environment variable or COORDINARE_INIT_API_KEY."
    },
    "max_concurrent_cards": {
      "$ref": "#/$defs/positiveInteger"
    },
    "human_reviewers": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "\\S",
          "description": "Comma-separated logins"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      ]
    },
    "run_mode": {
      "enum": [
        "local",
        "docker"
      ]
    },
    "image_variant": {
      "enum": [
        "base",
        "full"
      ]
    },
    "image_tag": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "positiveInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    }
  }
}
