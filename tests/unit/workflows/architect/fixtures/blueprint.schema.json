{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "milestones",
    "modules",
    "data_model",
    "interfaces",
    "risks",
    "criteria",
    "docs"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal",
          "scope",
          "done_when"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 200
          },
          "scope": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "done_when": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "note"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 120
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "data_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changes"
      ],
      "properties": {
        "changes": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "note"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "table",
                  "model",
                  "column",
                  "index",
                  "migration"
                ]
              },
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "contract"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "endpoint",
              "class",
              "event",
              "cli"
            ]
          },
          "contract": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "action",
          "expected",
          "kind"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "maxLength": 120
          },
          "action": {
            "type": "string",
            "maxLength": 200
          },
          "expected": {
            "type": "string",
            "maxLength": 300
          },
          "kind": {
            "enum": [
              "functional",
              "visual",
              "command"
            ]
          }
        }
      }
    },
    "docs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "location",
          "say"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "maxLength": 160
          },
          "say": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    }
  }
}