     "expect": {"activity_type": "output", "summary": "", "status": ""}},
    {"id": "failed", "event": {"type": "failed", "text": "gave up"},
     "expect": {"activity_type": "error", "summary": "", "status": ""}},
    {"id": "failure", "event": {"type": "failure", "text": "crashed"},
     "expect": {"activity_type": "error", "summary": "", "status": ""}},
