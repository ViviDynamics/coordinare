{
  "codex": {
    "project_name": "demo",
    "max_concurrent_cards": 1,
    "performers": {
      "default": {
        "backend": "codex",
        "mode": "starter"
      },
      "implementer": {
        "backend": "codex"
      }
    },
    "endpoints": [
      {
        "name": "starter",
        "kind": "openai",
        "auth_env": "OPENAI_API_KEY"
      }
    ],
    "model_endpoints": [
      {
        "name": "starter",
        "endpoint": "starter",
        "model": "gpt-5.4"
      }
    ],
    "modes": [
      {
        "name": "starter",
        "strategy": "single",
        "tool": "starter"
      }
    ],
    "env_passthrough": [
      "OPENAI_API_KEY"
    ],
    "performer_endpoints": [
      {
        "id": "starter",
        "mode": "ephemeral",
        "roles": [
          "implementer"
        ],
        "image": "coordinare-performer:full",
        "env": {
          "BACKEND": "codex"
        }
      }
    ],
    "preset": "containers",
    "harness": "codex",
    "github_repo": "demo"
  },
